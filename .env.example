APP_ENV=development
# Use your Neon connection string in production; local SQLite is convenient for offline development.
DATABASE_URL=sqlite:///./data/biotech.db
# Neon URL example: postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
SESSION_SECRET=change-this-for-local-development
JWT_SECRET=local-jwt-secret-change-before-deployment-please
JWT_EXPIRY_MINUTES=720
DEV_AUTH=false
IDENTIFIABLE_RECORDS_ENABLED=false
PATIENT_FIELD_ENCRYPTION_KEY=
MAX_UPLOAD_MB=20
LOCAL_UPLOAD_DIR=./data/uploads
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_REQUEST_LIMIT=100
ALLOWED_ORIGINS=http://localhost:8000
EDITOR_EMAILS=
